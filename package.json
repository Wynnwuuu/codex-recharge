{
  "name": "codex-recharge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Remotion recharge animation and a local macOS Codex usage companion.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "studio": "remotion studio src/remotion.tsx",
    "render": "node scripts/render.mjs",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "telemetry": "node telemetry/cli.mjs",
    "test": "node --test tests/*.test.mjs && python3 tests/telemetry-tasks.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@remotion/bundler": "4.0.535",
    "remotion": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
